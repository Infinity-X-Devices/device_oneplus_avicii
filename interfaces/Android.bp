hidl_package_root {
    name: "vendor.oplus",
    path: "device/oneplus/avicii/interfaces/oplus",
}

aidl_interface {
    name: "vendor.lineage.oplus_als",
    vendor_available: true,
    local_include_dir: "aidl",
    srcs: ["aidl/vendor/lineage/oplus_als/*.aidl"],
    stability: "vintf",
    owner: "lineage",

    backend: {
        cpp: {
            enabled: false,
        },
        java: {
            enabled: false,
        },
    },
    versions_with_info: [
        {
            version: "1",
            imports: [],
        },
    ],
}
